# Static analysis for the PHP port.
#
# Do not add a baseline to fake a higher number: fix the code or leave the level.
includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
parameters:
    level: 9
    # Infer types for every PHP version the package supports, not just the one PHPStan runs on,
    # so the result doesn't depend on which PHP the CI job uses. Language features newer than
    # the minimum are flagged either way (from composer.json's "php"). A call to a function
    # newer than the minimum is not, since PHPStan takes functions from the PHP it runs on;
    # the per-version test matrix catches those the tests reach. Keep min in step with
    # composer.json's "php" and max with the newest version in the CI matrix.
    phpVersion:
        min: 80100
        max: 80599
    paths:
        - src
        - tests
    # Some defensive guards in src/ protect against vendor/stdlib return values that
    # the vendor's *PHPDoc* claims are impossible (html5-php's loadHTMLFragment,
    # MessageFormatter::create). A PHPDoc annotation is not a runtime guarantee, so
    # we keep the guards and tell PHPStan not to treat those annotations as certain.
    treatPhpDocTypesAsCertain: false
    # tests/ValueObjectsTest.php carries @phpstan-ignore-next-line comments for
    # deliberately malformed inputs. At level 9 every one of them matches a real
    # error, so an unmatched ignore now means the comment is stale — fail on it.
    reportUnmatchedIgnoredErrors: true
